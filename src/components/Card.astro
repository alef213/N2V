---
interface Props {
  title: string;
  eyebrow?: string;
  href?: string;
  meta?: string;
}

const { title, eyebrow, href, meta } = Astro.props;
---

<article class="bg-paper border border-offwhite rounded-lg p-6 flex flex-col gap-3 hover:shadow-md transition-shadow duration-200">
  {eyebrow && (
    <p class="text-sm font-semibold uppercase tracking-wider text-teal">
      {eyebrow}
    </p>
  )}

  <h3 class="font-serif text-navy leading-snug">
    {href ? (
      <a
        href={href}
        class="hover:underline underline-offset-4 decoration-gold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold focus-visible:ring-offset-2"
      >
        {title}
      </a>
    ) : (
      title
    )}
  </h3>

  <div class="text-ink text-sm leading-relaxed">
    <slot />
  </div>

  {meta && (
    <p class="text-muted text-sm mt-auto pt-2 border-t border-offwhite">
      {meta}
    </p>
  )}
</article>
