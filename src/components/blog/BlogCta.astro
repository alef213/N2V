---
interface Props {
  substackUrl: string;
  embedUrl: string;
}

const { substackUrl, embedUrl } = Astro.props;
---

<section class="bg-navy text-offwhite py-[var(--space-section)] px-4">
  <div class="max-w-2xl mx-auto text-center">
    <h2
      class="font-serif text-offwhite leading-tight mb-4"
      style="font-size: var(--fs-h2);"
    >
      Get new essays the day they drop.
    </h2>

    <p class="text-offwhite opacity-75 leading-relaxed mb-8" style="font-size: var(--fs-body);">
      Sundays. Teacher-voice. No sales pitches.
    </p>

    <!-- Substack subscribe iframe — handles email collection on Substack's side -->
    <div class="mb-4 mx-auto max-w-md bg-offwhite rounded overflow-hidden">
      <iframe
        src={embedUrl}
        title="Subscribe to Mike's Substack"
        width="100%"
        height="320"
        style="border: 0; background: transparent;"
        sandbox="allow-scripts allow-forms allow-popups allow-same-origin"
        loading="lazy"
      ></iframe>
    </div>

    <p class="text-offwhite opacity-60 text-sm">
      Or read directly on&nbsp;
      <a
        href={substackUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="underline underline-offset-4 hover:opacity-100 transition-opacity duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold focus-visible:ring-offset-2 focus-visible:ring-offset-navy"
      >
        Substack
      </a>
    </p>
  </div>
</section>
