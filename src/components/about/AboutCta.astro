---
import Button from '../Button.astro';
---

<section class="bg-navy py-[var(--space-section)] px-4">
  <div class="max-w-5xl mx-auto text-center flex flex-col items-center gap-6">

    <h2
      class="font-serif text-offwhite leading-tight max-w-2xl"
      style="font-size: var(--fs-h2);"
    >
      Our blueprints are the simplest way to start
    </h2>

    <Button href="/blueprints" variant="inverse" size="lg">Explore our Free Blueprints</Button>

  </div>
</section>
