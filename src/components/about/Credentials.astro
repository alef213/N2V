---
const trackRecord: string[] = [
  '35 years in classroom teaching (K–12, public school)',
  '20 years specializing in learning support',
  'Worked with students across ADHD, autism, dyslexia, OCD, anxiety, dysgraphia',
  'Over a thousand families coached through the N2V approach',
];

const academic: string[] = [
  'M.Ed., Curriculum and Instruction — University of British Columbia',
  'Diploma in Special Education — University of British Columbia',
  'B.Ed. — University of British Columbia',
  'B.A. — Carleton University',
  'Varsity water polo — Carleton University and University of British Columbia',
];
---

<section class="bg-paper py-[var(--space-section)] px-4">
  <div class="max-w-5xl mx-auto">

    <!-- Section header -->
    <header class="mb-[var(--space-block)] max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-teal mb-3">Track record &amp; credentials</p>
      <h2 class="font-serif text-navy leading-tight" style="font-size: var(--fs-h2);">
        Three Decades in the Classroom and the Academic Spine Behind It
      </h2>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">

      <!-- Left: track record card -->
      <div class="bg-offwhite rounded-lg p-8 border border-offwhite">
        <p class="text-sm font-semibold uppercase tracking-wider text-muted mb-5">In practice</p>
        <ul class="flex flex-col gap-4">
          {trackRecord.map((fact) => (
            <li class="flex items-start gap-3">
              <span
                class="mt-1 shrink-0 w-5 h-5 rounded-full bg-teal flex items-center justify-center"
                aria-hidden="true"
              >
                <svg width="10" height="8" viewBox="0 0 10 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 4L3.8 7L9 1" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="text-charcoal leading-relaxed" style="font-size: var(--fs-body);">{fact}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Right: academic credentials card -->
      <div class="bg-offwhite rounded-lg p-8 border border-offwhite">
        <p class="text-sm font-semibold uppercase tracking-wider text-muted mb-5">Academic credentials</p>
        <ul class="flex flex-col gap-4">
          {academic.map((cred) => (
            <li class="flex items-start gap-3">
              <span
                class="mt-1 shrink-0 w-5 h-5 rounded-full bg-gold flex items-center justify-center"
                aria-hidden="true"
              >
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5 1L6.18 3.39L8.81 3.78L6.91 5.64L7.36 8.26L5 7.02L2.64 8.26L3.09 5.64L1.19 3.78L3.82 3.39L5 1Z" stroke="white" stroke-width="1.2" stroke-linejoin="round" />
                </svg>
              </span>
              <span class="text-charcoal leading-relaxed" style="font-size: var(--fs-body);">{cred}</span>
            </li>
          ))}
        </ul>
      </div>

    </div>
  </div>
</section>
