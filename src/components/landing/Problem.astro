---
import Card from '../Card.astro';
---

<section class="bg-paper py-[var(--space-section)] px-4">
  <div class="max-w-5xl mx-auto">

    <!-- Section heading -->
    <h2
      class="font-serif text-navy text-center leading-tight mb-[var(--space-block)]"
      style="font-size: var(--fs-h2);"
    >
      If this sounds like your house, you're in the right place.
    </h2>

    <!-- 3-column pain point grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

      <Card title="You're running out of lifeboats.">
        Interventions, tutors, IEPs — nothing stuck. Your child is falling further
        behind every semester, and every new attempt feels like another door closing.
      </Card>

      <Card title="The school treats your child like a number.">
        They don't see the gift inside your kid. You do — but nobody's shown you
        how to reach it at home, in the way your child actually learns.
      </Card>

      <Card title="You're scared of their future.">
        Will they waffle through life? Work a job they hate? Or become the exceptional
        adult you already know they can be — if someone just figures out the key?
      </Card>

    </div>

  </div>
</section>
