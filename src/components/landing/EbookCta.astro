---

<section class="bg-navy text-offwhite py-[var(--space-section)] px-4">
  <div class="max-w-3xl mx-auto text-center flex flex-col gap-6">

    <!-- Heading -->
    <h2
      class="font-serif text-offwhite leading-tight"
      style="font-size: var(--fs-h2);"
    >
      Start With the Strength-Based Student Profile
    </h2>

    <!-- Sub-copy -->
    <p
      class="leading-relaxed opacity-85 max-w-xl mx-auto"
      style="font-size: var(--fs-body);"
    >
      A short article + a one-sitting workbook to map your child's strengths,
      interests, learning style, and motivation patterns — the foundation
      every other intervention rests on.
    </p>

    <!-- CTA button -->
    <div class="flex justify-center">
      <a
        href="/blueprints/strength-based/"
        class="
          inline-block px-6 py-3 rounded font-semibold text-base
          bg-gold text-navy
          border-b-2 border-transparent
          hover:opacity-90 transition-opacity duration-200
          focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold focus-visible:ring-offset-2 focus-visible:ring-offset-navy
          whitespace-nowrap
        "
      >
        Start Here
      </a>
    </div>

  </div>
</section>
