---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Button from '../../../components/Button.astro';
import EbookList from '../../../components/ebooks/EbookList.astro';
import BlueprintCover from '../../../components/ebooks/BlueprintCover.astro';

export async function getStaticPaths() {
  const ebooks = await getCollection('ebooks');
  return ebooks.map((ebook) => ({
    params: { slug: ebook.id },
    props: { ebook, allEbooks: ebooks },
  }));
}

const { ebook, allEbooks } = Astro.props;
const { title, downloadFile, checklistName } = ebook.data;
const currentSlug: string = ebook.id;

// Derive a human-readable download link label from frontmatter checklistName.
// Falls back to generic text if the field isn't set.
const downloadLabel = checklistName
  ? `Download the ${checklistName} →`
  : 'Download your checklist →';

// Cross-sell list: every blueprint except the current one. Filter the
// collection that getStaticPaths already loaded — no second getCollection call.
const otherEbooks = allEbooks
  .filter((e) => e.id !== currentSlug)
  .sort((a, b) => a.data.order - b.data.order);

// When there's one other blueprint, we render a horizontal "feature" card
// inline (see markup below). When there are two+, we hand off to EbookList.
const single = otherEbooks.length === 1 ? otherEbooks[0] : null;
---

<Layout
  title={`Download Ready — ${title}`}
  description={`Your free copy of "${title}" by Mike Johnson is ready to download.`}
>
  <!-- ── Download confirmation ────────────────────────────────────────── -->
  <section class="bg-paper py-[var(--space-section)] px-4">
    <div class="max-w-2xl mx-auto text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-teal mb-4">
        You're in
      </p>

      <h1
        class="font-serif text-navy leading-tight mb-5"
        style="font-size: var(--fs-h1);"
      >
        Welcome to the reader list.
      </h1>

      <p class="text-ink opacity-80 mb-6" style="font-size: var(--fs-body);">
        Thanks for signing up!
      </p>

      <!-- What to expect next — the reader-list promise -->
      <p class="text-ink opacity-70 mb-10 max-w-xl mx-auto" style="font-size: var(--fs-body);">
        After this, you'll get one short essay every Sunday — one idea, one real
        classroom situation, never more than a 5-minute read.
      </p>

      <!-- Download section — directs reader straight to the checklist -->
      <div class="mt-4 pt-8 border-t border-muted/20 max-w-md mx-auto">
        <p class="text-muted mb-5" style="font-size: var(--fs-small);">
          Click the link below to download your checklist!
        </p>
        <a
          href={downloadFile}
          class="text-teal underline underline-offset-4 hover:decoration-2 transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal focus-visible:ring-offset-2"
          style="font-size: var(--fs-small);"
        >
          {downloadLabel}
        </a>
      </div>
    </div>
  </section>

  <!-- ── Cross-sell: one other blueprint (horizontal feature card) ────── -->
  {single && (
    <section class="bg-offwhite py-[var(--space-section)] px-4">
      <div class="max-w-4xl mx-auto">
        <header class="mb-10 text-center">
          <p class="text-sm font-semibold uppercase tracking-wider text-teal mb-3">
            While you're here
          </p>
          <h2
            class="font-serif text-navy leading-tight"
            style="font-size: var(--fs-h2);"
          >
            The Other Blueprint:
          </h2>
        </header>

        <a
          href={`/blueprints/${single.id}/`}
          class="
            group block bg-paper border border-offwhite rounded-lg overflow-hidden
            shadow-sm hover:shadow-md transition-shadow duration-200
            focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal focus-visible:ring-offset-2
          "
          aria-label={`See ${single.data.title}`}
        >
          <div class="grid grid-cols-1 md:grid-cols-5 gap-0 items-stretch">

            <!-- Thumbnail (2/5 at desktop) -->
            <div class="md:col-span-2">
              <BlueprintCover
                thumbnailFile={single.data.thumbnailFile}
                thumbnailTone={single.data.thumbnailTone}
                label={single.data.title}
                width={480}
                height={600}
                class="w-full h-full object-cover"
              />
            </div>

            <!-- Content (3/5 at desktop) -->
            <div class="md:col-span-3 p-6 sm:p-8 flex flex-col gap-4 justify-center">
              <p class="text-sm font-semibold uppercase tracking-wider text-teal">
                {single.data.length} · {single.data.readTime}
              </p>

              <h3
                class="font-serif text-navy leading-snug"
                style="font-size: var(--fs-h3);"
              >
                {single.data.title}
              </h3>

              <p class="text-muted leading-snug" style="font-size: var(--fs-small);">
                {single.data.subtitle}
              </p>

              {(single.data.highlights ?? []).length > 0 && (
                <ul class="flex flex-col gap-2 mt-2">
                  {(single.data.highlights ?? []).slice(0, 3).map((point) => (
                    <li class="flex gap-2 text-ink" style="font-size: var(--fs-small);">
                      <span class="text-teal mt-0.5 shrink-0" aria-hidden="true">&#x2022;</span>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              )}

              <span
                class="
                  mt-3 inline-flex items-center gap-1 self-start
                  text-sm font-semibold text-navy
                  group-hover:gap-2 transition-[gap] duration-150
                "
              >
                Explore this Strategy
                <span aria-hidden="true">→</span>
              </span>
            </div>

          </div>
        </a>
      </div>
    </section>
  )}

  <!-- ── Cross-sell: 2+ other blueprints (grid) ───────────────────────── -->
  {otherEbooks.length > 1 && (
    <section class="bg-offwhite py-[var(--space-section)] px-4">
      <div class="max-w-3xl mx-auto mb-[var(--space-block)]">
        <p class="text-sm font-semibold uppercase tracking-wider text-teal mb-3">
          While you're here
        </p>
        <h2
          class="font-serif text-navy leading-tight"
          style="font-size: var(--fs-h2);"
        >
          The Other Blueprints:
        </h2>
      </div>
      <EbookList ebooks={otherEbooks} tone="offwhite" maxWidth="max-w-3xl" />
    </section>
  )}

  <!-- ── Course waitlist ──────────────────────────────────────────────── -->
  <section class="bg-offwhite py-[var(--space-section)] px-4 border-t border-offwhite">
    <div class="max-w-2xl mx-auto">
      <div class="bg-paper border border-offwhite rounded-lg p-8 text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-muted mb-4">
          Coming soon
        </p>
        <h2
          class="font-serif text-navy leading-tight mb-4"
          style="font-size: var(--fs-h2);"
        >
          Want to go deeper?
        </h2>
        <p class="text-ink opacity-75 mb-8 max-w-lg mx-auto" style="font-size: var(--fs-body);">
          Mike's full Three-Loop Home System course — 12 modules, 40+ exercises,
          access to an adaptive tutoring software &amp; parent coaching Q&amp;A. Not available yet.
        </p>

        {/* Two routes to email Mike — primary opens Gmail compose in a new
            tab (covers most users on webmail), secondary opens the default
            email client via mailto: for everyone else. Mailto-as-link (not
            form) avoids the "not secure" browser warning. Swap both for a
            Formspree/Cloudflare Worker endpoint when chosen. */}
        <div class="flex flex-col items-center gap-3">
          <a
            href="https://mail.google.com/mail/?view=cm&fs=1&to=mjohnson@n2ved.com&su=Course%20waitlist&body=Hi%20Mike%2C%0A%0AI%27d%20like%20to%20be%20added%20to%20the%20waitlist%20for%20the%20Three-Loop%20Home%20System%20course.%20Please%20notify%20me%20when%20it%20launches.%0A%0AThanks%21"
            target="_blank"
            rel="noopener noreferrer"
            class="
              inline-block px-8 py-4
              bg-navy text-offwhite font-semibold rounded
              border-b-2 border-transparent
              hover:border-gold transition-colors duration-200
              focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-2
            "
            style="font-size: var(--fs-body);"
          >
            Open in Gmail
          </a>

          <a
            href="mailto:mjohnson@n2ved.com?subject=Course%20waitlist&body=Hi%20Mike%2C%0A%0AI%27d%20like%20to%20be%20added%20to%20the%20waitlist%20for%20the%20Three-Loop%20Home%20System%20course.%20Please%20notify%20me%20when%20it%20launches.%0A%0AThanks%21"
            class="
              text-sm text-muted underline underline-offset-4
              hover:text-navy transition-colors duration-150
              focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-2 rounded
            "
          >
            Or use your default email app
          </a>
        </div>
        <p class="mt-4 text-xs text-muted opacity-70 max-w-sm mx-auto">
          Either way, you'll get a pre-filled message — just hit send and Mike will add you to the list.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Blog closing panel ───────────────────────────────────────────── -->
  <section class="bg-navy text-offwhite py-[var(--space-section)] px-4">
    <div class="max-w-2xl mx-auto text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-gold mb-4">
        Keep reading
      </p>
      <h2
        class="font-serif text-offwhite leading-tight mb-5"
        style="font-size: var(--fs-h2);"
      >
        New essays every Sunday.
      </h2>
      <p class="opacity-80 mb-8" style="font-size: var(--fs-body);">
        Mike writes one short piece a week — one idea, applied to one real
        classroom situation. No filler.
      </p>
      <Button href="/blog" variant="inverse" size="lg">
        Browse the Essays →
      </Button>
    </div>
  </section>
</Layout>
